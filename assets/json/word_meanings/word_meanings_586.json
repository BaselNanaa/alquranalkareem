{
  "version": "1.0",
  "source": "تفسير الميسر",
  "word_meanings": [
    {
      "surah": 81,
      "ayah": 1,
      "start_word": 3,
      "end_word": 3,
      "text": "طُوِيَت وأُزيل ضَوؤها",
      "color": "#2E7D32"
    },
    {
      "surah": 81,
      "ayah": 2,
      "start_word": 3,
      "end_word": 3,
      "text": "خَرَجَت عَن مَداراتِها",
      "color": "#2E7D32"
    },
    {
      "surah": 81,
      "ayah": 3,
      "start_word": 3,
      "end_word": 3,
      "text": "قُلِعَت مِن أماكِنِها - جُمِعَت",
      "color": "#2E7D32"
    },
    {
      "surah": 81,
      "ayah": 4,
      "start_word": 3,
      "end_word": 3,
      "text": "النُّوق الحَوامِل - أُهمِلَت - لانشِغال الإنسان بنَفسِه",
      "color": "#2E7D32"
    },
    {
      "surah": 81,
      "ayah": 5,
      "start_word": 3,
      "end_word": 3,
      "text": "جُمِعَت",
      "color": "#2E7D32"
    },
    {
      "surah": 81,
      "ayah": 6,
      "start_word": 3,
      "end_word": 3,
      "text": "أُوقِدَت",
      "color": "#2E7D32"
    },
    {
      "surah": 81,
      "ayah": 7,
      "start_word": 3,
      "end_word": 3,
      "text": "قُرِنَت الأرواح بالأجساد",
      "color": "#2E7D32"
    },
    {
      "surah": 81,
      "ayah": 8,
      "start_word": 3,
      "end_word": 3,
      "text": "البِنت المَدفونة حَيَّة - صَحائِف الأعمال",
      "color": "#2E7D32"
    },
    {
      "surah": 81,
      "ayah": 10,
      "start_word": 3,
      "end_word": 3,
      "text": "فُلِعَت كما يُقلَع السَّقف",
      "color": "#2E7D32"
    },
    {
      "surah": 81,
      "ayah": 12,
      "start_word": 3,
      "end_word": 3,
      "text": "أُجِّجَت",
      "color": "#2E7D32"
    },
    {
      "surah": 81,
      "ayah": 13,
      "start_word": 3,
      "end_word": 3,
      "text": "قُرِّبَت لِلمُتَّقين",
      "color": "#2E7D32"
    },
    {
      "surah": 81,
      "ayah": 14,
      "start_word": 3,
      "end_word": 4,
      "text": "قَدَّمَت مِن خَير أو شَرّ",
      "color": "#2E7D32"
    },
    {
      "surah": 81,
      "ayah": 16,
      "start_word": 1,
      "end_word": 2,
      "text": "النُّجوم الجارِيات تَغيب صَباحاً",
      "color": "#2E7D32"
    },
    {
      "surah": 81,
      "ayah": 17,
      "start_word": 2,
      "end_word": 3,
      "text": "أقبَل وأدبَر بِظَلامِه",
      "color": "#2E7D32"
    },
    {
      "surah": 81,
      "ayah": 18,
      "start_word": 2,
      "end_word": 3,
      "text": "أظهَر ضَوؤه وانتَشَرَت نَسَماتُه",
      "color": "#2E7D32"
    },
    {
      "surah": 81,
      "ayah": 19,
      "start_word": 1,
      "end_word": 4,
      "text": "القُرآن - أجراه الله على لِسان جِبريل ﷺ",
      "color": "#2E7D32"
    },
    {
      "surah": 81,
      "ayah": 20,
      "start_word": 1,
      "end_word": 6,
      "text": "عَظيمة - مَكانة رَفيعة",
      "color": "#2E7D32"
    },
    {
      "surah": 81,
      "ayah": 21,
      "start_word": 3,
      "end_word": 3,
      "text": "في المَلَأ الأعلى - على الوَحي - مُحَمَّد ﷺ",
      "color": "#2E7D32"
    },
    {
      "surah": 81,
      "ayah": 22,
      "start_word": 1,
      "end_word": 3,
      "text": "رأى مُحَمَّد جِبريل على صُورَتِه",
      "color": "#2E7D32"
    },
    {
      "surah": 81,
      "ayah": 23,
      "start_word": 1,
      "end_word": 1,
      "text": "مُحَمَّد ﷺ - تَبليغ الرِّسالة - بِبَخيل - مَطرود",
      "color": "#2E7D32"
    },
    {
      "surah": 81,
      "ayah": 26,
      "start_word": 1,
      "end_word": 2,
      "text": "القُرآن - بَعد إنكارِكم القُرآن - تَذكير",
      "color": "#2E7D32"
    },
    {
      "surah": 81,
      "ayah": 28,
      "start_word": 5,
      "end_word": 5,
      "text": "على طَريق الحَقّ - سُلوك طَريق الخَير أو الشَّر - استِقامَتِكم بمَشيئَتِه الحُرَّة",
      "color": "#2E7D32"
    }
  ]
}