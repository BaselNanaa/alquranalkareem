{
  "version": "1.0",
  "source": "تفسير الميسر",
  "word_meanings": [
    {
      "surah": 78,
      "ayah": 1,
      "start_word": 1,
      "end_word": 2,
      "text": "عَن أيِّ شَيء",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 2,
      "start_word": 2,
      "end_word": 3,
      "text": "الخَبَر",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 3,
      "start_word": 1,
      "end_word": 4,
      "text": "وهو البَعث",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 2,
      "start_word": 2,
      "end_word": 2,
      "text": "المُشرِكون",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 3,
      "start_word": 4,
      "end_word": 4,
      "text": "بَين مُشَكِّكين ومُعانِدين",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 4,
      "start_word": 1,
      "end_word": 2,
      "text": "عِند نَزع أرواحِهم",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 5,
      "start_word": 1,
      "end_word": 3,
      "text": "عاقِبة تَكذِيبِهم عِند البَعث",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 6,
      "start_word": 4,
      "end_word": 4,
      "text": "مُمَهَّدة كالفِراش",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 7,
      "start_word": 2,
      "end_word": 2,
      "text": "كالأوتاد المُثَبِّتة للخِيام",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 8,
      "start_word": 2,
      "end_word": 2,
      "text": "ذُكوراً وإناثاً وأصنافاً مُختلِفة",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 9,
      "start_word": 3,
      "end_word": 3,
      "text": "لِتَستَريحوا فيه",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 10,
      "start_word": 3,
      "end_word": 3,
      "text": "تُلبِسُكم ظُلمَتَه وتَغطِيكم",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 11,
      "start_word": 3,
      "end_word": 3,
      "text": "سَبَباً للمَعاش",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 12,
      "start_word": 3,
      "end_word": 4,
      "text": "سماوات مُحكَمات",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 13,
      "start_word": 2,
      "end_word": 3,
      "text": "الشَّمس مصباحاً مُضيئاً بالِغ الحَرارة",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 14,
      "start_word": 2,
      "end_word": 5,
      "text": "السُّحُب - مُتتابِعاً شَديد الانصِباب",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 15,
      "start_word": 3,
      "end_word": 4,
      "text": "كالشَّعير - كالحَشيش",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 16,
      "start_word": 2,
      "end_word": 2,
      "text": "مُلتَفَّة الأشجار",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 17,
      "start_word": 5,
      "end_word": 5,
      "text": "القَضاء بَين الخَلائق - مَوعِداً مُوَقَّتاً ومَكاناً مُحَدَّداً",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 17,
      "start_word": 2,
      "end_word": 2,
      "text": "النَّفخة الثانِية",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 18,
      "start_word": 6,
      "end_word": 6,
      "text": "جَماعات وأمَماً",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 19,
      "start_word": 1,
      "end_word": 1,
      "text": "شُقَّت",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 19,
      "start_word": 4,
      "end_word": 4,
      "text": "لِنُزول المَلائِكة",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 20,
      "start_word": 4,
      "end_word": 4,
      "text": "عَن وَجه الأرض - هَباءً مُنبَثَّاً - تَرتَقِب الكُفَّار",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 22,
      "start_word": 1,
      "end_word": 1,
      "text": "مَرجِعاً",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 22,
      "start_word": 2,
      "end_word": 2,
      "text": "ماكِثين",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 23,
      "start_word": 3,
      "end_word": 3,
      "text": "دُهوراً لا تَنقَطِع",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 24,
      "start_word": 4,
      "end_word": 4,
      "text": "يُغنيهم عَن عَطش",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 25,
      "start_word": 3,
      "end_word": 3,
      "text": "بَرودة",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 25,
      "start_word": 2,
      "end_word": 2,
      "text": "ماء حارَّاً",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 25,
      "start_word": 3,
      "end_word": 3,
      "text": "صَديداً مُنتِناً",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 26,
      "start_word": 2,
      "end_word": 2,
      "text": "مُوافِقاً لأعمالِهم",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 27,
      "start_word": 3,
      "end_word": 5,
      "text": "لا يَتوَقَّعون لِقاء ربِّهم يَوم القِيامة للحِساب",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 28,
      "start_word": 3,
      "end_word": 3,
      "text": "تَكذيباً مُفرِطاً",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 29,
      "start_word": 4,
      "end_word": 4,
      "text": "في اللَّوح المَحفوظ",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 30,
      "start_word": 4,
      "end_word": 5,
      "text": "تَجرَعوا عَذاب الحَريق - مِن الأعمال",
      "color": "#2E7D32"
    }
  ]
}