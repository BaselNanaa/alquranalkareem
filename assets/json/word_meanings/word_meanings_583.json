{
  "version": "1.0",
  "source": "تفسير الميسر",
  "word_meanings": [
    {
      "surah": 78,
      "ayah": 31,
      "start_word": 3,
      "end_word": 3,
      "text": "فَوزاً مِن النَّعيم",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 33,
      "start_word": 2,
      "end_word": 2,
      "text": "تَكَعَّبَت أثداؤهن - مُستَويات في السِّنِّ",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 34,
      "start_word": 2,
      "end_word": 2,
      "text": "مَملوءة مِن خَمر الجَنَّة",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 35,
      "start_word": 1,
      "end_word": 6,
      "text": "كَلاماً لا يُعتَد به - ولا يُكَذِّب بَعضُهم بَعضاً",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 36,
      "start_word": 4,
      "end_word": 4,
      "text": "وافِياً مِن غَير مُقابِل",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 36,
      "start_word": 5,
      "end_word": 5,
      "text": "والمُهَيمِن عَلَيهما - الخَلائِق",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 37,
      "start_word": 9,
      "end_word": 10,
      "text": "بِإذنِه",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 38,
      "start_word": 3,
      "end_word": 4,
      "text": "جِبريل ﷺ",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 37,
      "start_word": 7,
      "end_word": 7,
      "text": "بِشَفاعة لأحَد",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 38,
      "start_word": 14,
      "end_word": 14,
      "text": "حَقَّاً وسَداداً",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 39,
      "start_word": 3,
      "end_word": 3,
      "text": "الثابِت الوُقوع",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 39,
      "start_word": 5,
      "end_word": 9,
      "text": "مَرجِعاً حَسَناً بالإيمان والعَمل الصالِح",
      "color": "#2E7D32"
    },
    {
      "surah": 78,
      "ayah": 40,
      "start_word": 6,
      "end_word": 10,
      "text": "مِن خَير أو شَرّ - فَلا أعذَب",
      "color": "#2E7D32"
    },
    {
      "surah": 79,
      "ayah": 1,
      "start_word": 1,
      "end_word": 2,
      "text": "المَلائِكة التي تَنزِع أرواح الكُفَّار",
      "color": "#2E7D32"
    },
    {
      "surah": 79,
      "ayah": 2,
      "start_word": 1,
      "end_word": 2,
      "text": "المَلائِكة التي تَجذِب أرواح المُؤمِنين بِرِفق",
      "color": "#2E7D32"
    },
    {
      "surah": 79,
      "ayah": 3,
      "start_word": 1,
      "end_word": 2,
      "text": "المَلائِكة الذين يَترَقَّبون أوامِر ربِّهم",
      "color": "#2E7D32"
    },
    {
      "surah": 79,
      "ayah": 4,
      "start_word": 1,
      "end_word": 2,
      "text": "المَلائِكة المُسرِعات لِتَنفيذ أوامِر الله",
      "color": "#2E7D32"
    },
    {
      "surah": 79,
      "ayah": 5,
      "start_word": 1,
      "end_word": 2,
      "text": "المَلائِكة المُنفِّذات ما دَبَّره الله",
      "color": "#2E7D32"
    },
    {
      "surah": 79,
      "ayah": 6,
      "start_word": 1,
      "end_word": 3,
      "text": "لتُبعَثَنَّ تَهتَزُّ الأرض بالنَّفخة الأُولى",
      "color": "#2E7D32"
    },
    {
      "surah": 79,
      "ayah": 7,
      "start_word": 2,
      "end_word": 2,
      "text": "النَّفخة الثانِية",
      "color": "#2E7D32"
    },
    {
      "surah": 79,
      "ayah": 8,
      "start_word": 1,
      "end_word": 3,
      "text": "الكُفَّار - خائِفة",
      "color": "#2E7D32"
    },
    {
      "surah": 79,
      "ayah": 9,
      "start_word": 2,
      "end_word": 2,
      "text": "ذَليلة",
      "color": "#2E7D32"
    },
    {
      "surah": 79,
      "ayah": 10,
      "start_word": 3,
      "end_word": 5,
      "text": "كانوا - بَعد المَوت إلى الحَياة",
      "color": "#2E7D32"
    },
    {
      "surah": 79,
      "ayah": 11,
      "start_word": 3,
      "end_word": 4,
      "text": "بالِية",
      "color": "#2E7D32"
    },
    {
      "surah": 79,
      "ayah": 12,
      "start_word": 4,
      "end_word": 5,
      "text": "رَجعة - خائِبة",
      "color": "#2E7D32"
    },
    {
      "surah": 79,
      "ayah": 13,
      "start_word": 3,
      "end_word": 4,
      "text": "فَلا يَحتاج الأمر لِعَناء صَيحة",
      "color": "#2E7D32"
    },
    {
      "surah": 79,
      "ayah": 14,
      "start_word": 1,
      "end_word": 3,
      "text": "أحياءً على وَجه الأرض",
      "color": "#2E7D32"
    },
    {
      "surah": 79,
      "ayah": 15,
      "start_word": 1,
      "end_word": 4,
      "text": "أيُّها المُخاطَب",
      "color": "#2E7D32"
    }
  ]
}