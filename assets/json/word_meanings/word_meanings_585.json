    },
    {
      "surah": 80,
      "ayah": 1,
      "start_word": 2,
      "end_word": 2,
      "text": "أدارَ ظَهرَه",
      "color": "#2E7D32"
    },
    {
      "surah": 80,
      "ayah": 2,
      "start_word": 1,
      "end_word": 3,
      "text": "عبد الله بنُ أم مكتوم مسترشداً",
      "color": "#2E7D32"
    },
    {
      "surah": 80,
      "ayah": 3,
      "start_word": 4,
      "end_word": 4,
      "text": "يَتطهَّر من الذنوب",
      "color": "#2E7D32"
    },
    {
      "surah": 80,
      "ayah": 4,
      "start_word": 2,
      "end_word": 2,
      "text": "يتذكَّر",
      "color": "#2E7D32"
    },
    {
      "surah": 80,
      "ayah": 5,
      "start_word": 3,
      "end_word": 3,
      "text": "المَوعِظة",
      "color": "#2E7D32"
    },
    {
      "surah": 80,
      "ayah": 6,
      "start_word": 3,
      "end_word": 3,
      "text": "تَقبَّل عليه",
      "color": "#2E7D32"
    },
    {
      "surah": 80,
      "ayah": 7,
      "start_word": 1,
      "end_word": 2,
      "text": "لا حَرَج",
